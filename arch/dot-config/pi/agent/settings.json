{
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-6-luna",
  "defaultThinkingLevel": "xhigh",
  "theme": "system",
  "externalEditor": "vim",
  "enableAnalytics": false,
  "enableInstallTelemetry": false,
  "enabledModels": [
    "openai-codex/*",
    "opencode-go/*"
  ],
  "compaction": {
    "enabled": true,
    "reserveTokens": 16384,
    "keepRecentTokens": 20000
  },
  "retry": {
    "enabled": true,
    "maxRetries": 3
  },
  "steeringMode": "all",
  "warnings": {
    "missingMcpServers": true,
    "missingLanguageServers": true,
    "unsupportedThinking": true
  },
  "terminal": {
    "showImages": true
  },
  "images": {
    "autoResize": true
  },
  "lastChangelogVersion": "1.0.0",
  "packages": [
    "npm:@spences10/pi-lsp",
    "npm:@lll9p/pi-better-compaction"
  ],
  "showHardwareCursor": false,
  "hideThinkingBlock": true,
  "extensions": [
    "+builtin:mcp"
  ]
}